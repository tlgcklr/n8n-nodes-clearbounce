      "id": "d4a6f5a3-0004-4f4b-8d40-000000000019",
      "name": "Get Results",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "// Put each result back on the row it came from.\nconst results = new Map(\n  $input.first().json.results.map((r) => [String(r.email).toLowerCase(), r]),\n);\n\nreturn $('Read Contacts').all().map((row) => {\n  const email = String(row.json.email ?? '').trim().toLowerCase();\n  const r = results.get(email);\n  return {\n    json: {\n      row_number: row.json.row_number,\n      status: r ? r.status : 'undeliverable',\n      reason: r ? r.reason : 'invalid_syntax',\n      score: r ? r.score : 0,\n    },\n  };\n});"
      },
