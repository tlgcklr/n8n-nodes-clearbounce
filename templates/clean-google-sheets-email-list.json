      "id": "d4a6f5a3-0004-4f4b-8d40-000000000011",
      "name": "Read Contacts",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        200,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "// Trim, lowercase and de-duplicate addresses. Malformed addresses are left out:\n// ClearBounce rejects the whole upload if one of them is invalid.\nconst valid = /^(?!\\.)(?!.*\\.\\.)([A-Z0-9_'+\\-.]*)[A-Z0-9_+-]@([A-Z0-9][A-Z0-9-]*\\.)+[A-Z]{2,}$/i;\nconst emails = [...new Set(\n  $input.all()\n    .map((item) => String(item.json.email ?? '').trim().toLowerCase())\n    .filter((email) => valid.test(email)),\n)];\n\nif (emails.length === 0) {\n  throw new Error(\"No valid addresses found. Check that your sheet has an 'email' column.\");\n}\nif (emails.length > 10000) {\n  throw new Error(`Found ${emails.length} addresses; one run handles up to 10,000. Split the sheet and run again.`);\n}\nreturn [{ json: { emails } }];"
      },
      "id": "d4a6f5a3-0004-4f4b-8d40-000000000012",
      "name": "Prepare Email List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        360,
        80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.clearbounce.net/api/v1/bulk/upload",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ emails: $json.emails }) }}",
        "options": {}
      },
