{
  "name": "n8n-nodes-clearbounce",
  "version": "0.1.2",
  "description": "ClearBounce email verification and email finder for n8n: verify single addresses, clean whole lists in bulk jobs, find business emails.",
  "license": "MIT",
  "homepage": "https://clearbounce.net",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "clearbounce",
    "email verification",
    "email validation",
    "email verifier",
    "bounce",
    "email finder"
  ],
  "author": {
    "name": "Tolga Cakular",
    "email": "tolga@clearbounce.net"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tlgcklr/n8n-nodes-clearbounce.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/ClearBounceApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/ClearBounce/ClearBounce.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.53.4",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "bugs": {
    "url": "https://github.com/tlgcklr/n8n-nodes-clearbounce/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
